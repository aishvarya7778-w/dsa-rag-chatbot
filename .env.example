# =====================================================================
# DSA RAG Chatbot - Environment Variables Template
# =====================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env` in the project root.
# 2. Fill in your actual API keys and configuration values below.
# 3. Never commit your `.env` file to version control.
# =====================================================================

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Vector Database API Key and Index
# Obtain from: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=dsa-rag-index

# Optional Configuration Overrides:
# Google Embedding Model (must output 768 dimensions for gemini-embedding-001)
EMBEDDING_MODEL=gemini-embedding-001

# Gemini Generation Model
LLM_MODEL=gemini-3.5-flash

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retriever Configuration
TOP_K_RESULTS=4

# Rate Limit & Backoff Configuration (Optional)
EMBEDDING_BATCH_SIZE=20
INTER_BATCH_DELAY=1.5
MAX_RETRIES=5
INITIAL_RETRY_DELAY=5.0
